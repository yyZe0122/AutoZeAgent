[Unit]
Description=YunmengZe Agent local-first agent core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yunmengze
Group=yunmengze
UMask=0027
WorkingDirectory=/var/lib/yunmengze
EnvironmentFile=-/etc/yunmengze/planner.env
ExecStartPre=/usr/local/bin/ymz config validate --mode system
ExecStart=/usr/local/bin/ymzd --mode system
ExecStartPost=/usr/local/bin/ymz health --mode system
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=control-group
RuntimeDirectory=yunmengze
RuntimeDirectoryMode=0750
StateDirectory=yunmengze
StateDirectoryMode=0750
LogsDirectory=yunmengze
LogsDirectoryMode=0750
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yunmengze /run/yunmengze /var/log/yunmengze
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
