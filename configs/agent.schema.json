{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ymz.local/schema/agent.json",
  "title": "YunmengZe Agent provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "provider"],
  "properties": {
    "$schema": {"type": "string"},
    "model": {"type": "string", "pattern": "^[^/\\s]+/.+$"},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional role → provider/model overrides (ADR-045). Unset roles fall back to top-level model. Do not set models.main.",
      "properties": {
        "subagent": {
          "type": "string",
          "pattern": "^[^/\\s]+/.+$",
          "description": "Model for task tool child runs. Omit → main model."
        },
        "compact": {
          "type": "string",
          "pattern": "^[^/\\s]+/.+$",
          "description": "Model for session head compaction summaries. Omit → main model."
        }
      }
    },
    "provider": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/provider"}
    },
    "chat": {"$ref": "#/$defs/chat"}
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options"],
      "properties": {
        "type": {"$ref": "#/$defs/protocol"},
        "protocol": {"$ref": "#/$defs/protocol"},
        "options": {"$ref": "#/$defs/options"},
        "models": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/model"}
        }
      }
    },
    "protocol": {
      "type": "string",
      "enum": [
        "openai-chat", "openai-chat-completions", "chat-completions", "openai-compatible", "openai-compat",
        "ollama", "lmstudio", "llamacpp", "vllm", "litellm",
        "openai-responses", "openai", "responses",
        "anthropic-messages", "anthropic", "anthropic-compatible", "claude",
        "gemini-generate-content", "gemini", "google", "google-generative-ai"
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseURL"],
      "properties": {
        "baseURL": {"type": "string", "format": "uri"},
        "apiKey": {"type": "string"},
        "completionPath": {"type": "string", "pattern": "^/"},
        "modelsPath": {"type": "string", "pattern": "^/"},
        "responseFormat": {"enum": ["auto", "json_schema", "json_object"]},
        "anthropicVersion": {"type": "string"},
        "headers": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Wire/API model id (OpenCode model.id). When omitted, the catalog key / selection model segment is sent upstream."
        },
        "responseFormat": {"enum": ["auto", "json_schema", "json_object"]},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "maxTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Model-level output-token cap (not context length)."
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 0,
          "description": "Model context length in tokens for UI/metrics. Omit or 0 when unknown. Not maxTokens."
        },
        "reasoningEffort": {"type": "string", "minLength": 1}
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "description": "Session chat workspace. Tab agent=build (write) vs plan=read-only. allow_write is agent ceiling only.",
      "properties": {
        "roots": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Legacy absolute roots (merged into workspace ceiling). Prefer chat.workspace."
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "description": "Session workspace binding (ADR-046). Client cwd is default session root.",
          "properties": {
            "default": {
              "type": "string",
              "description": "client_cwd (default) | daemon_cwd | absolute path"
            },
            "allow": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "description": "Extra absolute roots always on the path ceiling"
            },
            "allow_all": {
              "type": "boolean",
              "default": false,
              "description": "Disable path-root containment (local single-user only; high risk)"
            }
          }
        },
        "allow_write": {
          "type": "boolean",
          "default": true,
          "description": "Ceiling for agent (build) write tools. Omit = true. Plan mode is always read-only."
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "description": "Opt-in high-risk tools for agent mode only (default all false). Plan never receives these.",
          "properties": {
            "git": {
              "type": "boolean",
              "default": false,
              "description": "Pre-authorize git_status/diff/add/commit under chat roots (agent only)."
            },
            "process": {
              "type": "boolean",
              "default": false,
              "description": "Pre-authorize process_exec under chat roots (agent only)."
            }
          }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "description": "Session head summarization (ADR-041). Omit = enabled.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable session compaction. Omit = true."
            }
          }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 16,
          "description": "Agent tool-loop cap per chat run (1–64). Omit = 16."
        },
        "permission": {
          "type": "object",
          "additionalProperties": false,
          "description": "Tool-call permission interaction (ADR-043). Omit = preauth.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["preauth", "ask", "auto"],
              "default": "preauth",
              "description": "preauth = deny without grant (default); ask = interactive tool-call queue; auto reserved."
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "description": "In-process layered memory (ADR-044). Omit = enabled defaults.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable memory manager. Omit = true."
            },
            "max_inject_runes": {
              "type": "integer",
              "minimum": 200,
              "maximum": 16000,
              "default": 2000,
              "description": "Cap frozen system memory inject block."
            },
            "inject_mode": {
              "type": "string",
              "enum": ["session_start"],
              "default": "session_start",
              "description": "Frozen snapshot at session start; refresh via /refresh-memory."
            },
            "session_search": {
              "type": "boolean",
              "default": true,
              "description": "Enable transcript FTS session_search tool."
            },
            "curator": {
              "type": "object",
              "additionalProperties": false,
              "description": "H1-lite post-turn LLM fact extraction (uses models.compact when set).",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable curator when memory is on. Omit = true."
                },
                "max_facts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8,
                  "default": 3,
                  "description": "Max facts written per successful turn."
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 120000,
                  "default": 15000,
                  "description": "Aux completion timeout in milliseconds."
                }
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["template"],
            "properties": {
              "description": {
                "type": "string",
                "description": "Short help for completer / list API"
              },
              "template": {
                "type": "string",
                "minLength": 1,
                "description": "User-message body; optional $ARGUMENTS or $0 placeholder"
              }
            }
          },
          "description": "User slash templates (O3). Keys are slash names without /. Instruction only — no grants. Injectscan at load."
        }
      }
    }
  }
}
