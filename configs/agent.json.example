{
  "$schema": "./configs/agent.schema.json",
  "model": "deepseek/deepseek-chat",
  "models": {
    "subagent": "deepseek/deepseek-chat",
    "compact": "deepseek/deepseek-chat"
  },
  "provider": {
    "deepseek": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat",
          "temperature": 0.2,
          "maxTokens": 4096,
          "contextWindow": 65536
        }
      }
    },
    "openai": {
      "type": "openai",
      "options": {
        "baseURL": "https://api.openai.com",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-model-id": {
          "name": "OpenAI Responses model",
          "reasoningEffort": "high"
        }
      }
    },
    "anthropic": {
      "type": "anthropic",
      "options": {
        "baseURL": "https://api.anthropic.com",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-model-id": {
          "name": "Claude model"
        }
      }
    },
    "google": {
      "type": "gemini",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com",
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-model-id": {
          "name": "Gemini model"
        }
      }
    },
    "literal-key-example": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.example.com",
        "apiKey": "sk-replace-with-your-key"
      },
      "models": {
        "demo": {
          "name": "Literal apiKey example (optional; prefer env or file)"
        }
      }
    },
    "file-key-example": {
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://api.example.com",
        "apiKey": "{file:secrets/demo.key}"
      },
      "models": {
        "demo": {
          "name": "File-ref apiKey example (path relative to config dir)"
        }
      }
    }
  },
  "chat": {
    "roots": [],
    "workspace": {
      "default": "client_cwd",
      "allow": [],
      "allow_all": false
    },
    "allow_write": true,
    "tools": {
      "git": false,
      "process": false
    },
    "compaction": { "enabled": true },
    "max_iterations": 16,
    "permission": { "mode": "preauth" }
  }
}
